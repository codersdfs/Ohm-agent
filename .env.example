# Omega Agent — API Key
# After running `omega provider`, the API key is saved here automatically.
# You can also set it manually:
#   OMEGA_API_KEY=sk-...
#
# Supported providers: openai, anthropic, google, mistral, xai, cerebras,
# groq, kimi, minimax, openrouter, azure, bedrock, huggingface, local
OMEGA_API_KEY=

# Quality Gate enforcement mode (default: warn)
#   warn   — write/edit proceeds, violations are reported to the model
#   block  — write/edit is REJECTED before touching disk when score < 80
#   advice — gate runs, violations are logged only
# Escape hatch: if the Gate ever blocks a legitimate edit, set this to warn.
# OMEGA_GATE_MODE=warn
OMEGA_API_KEY=
